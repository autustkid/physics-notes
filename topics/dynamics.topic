D.ci(s, wx, wy, R, 'ink', 'var(--bg)');
D.ci(s, wx, wy, 10, 'ink', 'var(--bg)');
D.re(s, wx-20, 198, 40, 9, 'ink', 'var(--panel)');
D.ln(s, wx, 207, wx, 236, 'ink');
D.re(s, wx-30, 236, 60, 42, 'ink', 'var(--panel)');
D.ar(s, wx+50, 280, wx+50, 234, 'mut');
D.ar(s, wx, 257, wx, 314, 'blue');
D.dt(s, wx, 257, 2.6);
