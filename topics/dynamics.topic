D.ar(s, ax, ay, ax, 40, 'mut');
D.tx(s, 'y', ax-4, 30, {c:'mut', size:12.5});
D.dt(s, ax, ay, 2.5, 'mut');
D.re(s, 150, 18, 110, 14, 'ink', 'url(#hatch)');
const sx = 205, sTop = 32, sBot = 120;
let d = 'M '+sx+' '+sTop;
for(let i = 0; i < 8; i++){const yy = sTop+(i+0.5)*(sBot-sTop)/8; d += ' L '+(sx+(i%2?14:-14))+' '+yy;}
d += ' L '+sx+' '+sBot;
D.pa(s, d, 'ink');
D.re(s, sx-25, 120, 50, 44, 'ink', 'var(--panel)');
const cy = 142;
D.ar(s, sx, cy, sx, 70, 'red');
D.tx(s, 'Fупр', sx+12, 76, {c:'red', anchor:'start', vec:true});
D.ar(s, sx, cy, sx, 220, 'blue');
D.tx(s, 'mg', sx+12, 232, {c:'blue', anchor:'start'});
D.dt(s, sx, cy, 2.6);
return s;
@end

@task | title: Растяжение пружины при подъёме с ускорением
Пружину, на которую подвесили груз массой 0,4 кг, за свободный конец поднимают вертикально вверх с ускорением 0,8 м/с². Жёсткость пружины 250 Н/м. Пренебрегая массой пружины, определите, на сколько увеличилась её длина по сравнению с недеформированным состоянием.
Дано:
  m = 0,4 кг
  a = 0,8 м/с²
  k = 250 Н/м
  g = 9,8 м/с²
Найти:
  Δx — ?
Решение:
  1. Ось Oy — вертикально вверх.
  2. Второй закон Ньютона: Fупр − mg = ma.
  3. Закон Гука: Fупр = kΔx.
  4. Δx = m(g + a) / k = 0,4 · 10,6 / 250 ≈ 0,017 м.
Ответ: ≈ 1,7 см.
@end

